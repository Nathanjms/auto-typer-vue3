{
  "name": "auto-typer-vue3",
  "version": "1.2.5",
  "description": "A simple Autotyper for Vue 3, with some customisation options.",
  "keywords": [
    "vue3",
    "typer",
    "autotyper",
    "auto-typer",
    "vuejs"
  ],
  "homepage": "https://github.com/Nathanjms/auto-typer-vue3#readme",
  "bugs": {
    "url": "https://github.com/Nathanjms/auto-typer-vue3/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nathanjms/auto-typer-vue3.git"
  },
  "license": "MIT",
  "author": "Nathan James <nathan@nathanjms.co.uk>",
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "files": [
    "dist",
    "package.json",
    "README.md",
    "global.d.ts"
  ],
  "scripts": {
    "dev:install": "(cd ./playground && npm install)",
    "dev:run": "(cd ./playground && npm run dev)",
    "dev:run-pack": "(cd ./playground && npm run dev:usepack)",
    "prepublishOnly": "npm test && npm run build",
    "build": "npm run typecheck && vite build && npm run build:css",
    "build:vite": "npm run build",
    "build:css": "sass --no-source-map --style=compressed src/styles/main.scss dist/style.css",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "jsdom": "^30.0.1",
    "sass": "^1.103.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "vue": "^3"
  }
}
